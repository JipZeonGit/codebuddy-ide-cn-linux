# It contains no proprietary code; it only orchestrates the download,
# extraction, and packaging of upstream binaries that the end user
# fetches directly from Tencent's official CDN at install time.
#
# The packaged software (Tencent CodeBuddy IDE) remains subject to
# Tencent's proprietary CodeBuddy service license, NOT this MIT notice.

pkgname=codebuddy-ide-cn
_cb_ver=4.10.1
_cb_build=33158423
_cb_hash=3ad58bcb
pkgver="${_cb_ver}.${_cb_build}"
pkgrel=1
pkgdesc='腾讯云代码助手CodeBuddy IDE，是一款辅助编码工具。'
arch=('x86_64')
url='https://github.com/JipZeonGit/codebuddy-ide-cn-linux'
license=('LicenseRef-Tencent-CodeBuddy')

depends=(
    'gtk3' 'nss' 'libxss' 'alsa-lib' 'libsecret' 'libxkbfile'
)

# Conflict with old package names
conflicts=('codebuddy-cn-ide' 'codebuddycn-ide')
options=('!strip' '!debug')

source=(
    "codebuddy-cn_${pkgver}_amd64.deb::https://download.codebuddy.cn/aiide/linux-x64/CodeBuddy-linux-x64-${pkgver}-${_cb_hash}-cn.deb"
    "LICENSE.notice"
)

sha256sums=(
    '838fe89a19f2cac23c02aab67bf5cb34e613323cd47cb811588a3d90d4fe4398'
    'b3260549a765c478dc33680c7b9a1a30e5a038456e340d6d25f7748390724241'
)

package() {
  local data_archive
  data_archive=$(find "${srcdir}" -maxdepth 1 -name "data.tar.*" | head -n 1)
  [ -n "$data_archive" ] || {
      # Fallback: extract the deb manually using ar if not extracted automatically
      local deb_file
      deb_file=$(find "${srcdir}" -maxdepth 1 -name "*.deb" | head -n 1)
      [ -n "$deb_file" ] || { echo "ERROR: deb file not found" >&2; return 1; }
      ar x "$deb_file"
      data_archive=$(find . -maxdepth 1 -name "data.tar.*" | head -n 1)
  }

  install -d "${pkgdir}/opt/${pkgname}"
  install -d "${pkgdir}/usr/bin"
  install -d "${pkgdir}/usr/share/applications"
  install -d "${pkgdir}/usr/share/icons/hicolor/256x256/apps"

  if [ -n "$data_archive" ]; then
      # Extract directly from the tarball to save disk space and time
      tar -xf "$data_archive" -C "${pkgdir}/opt/${pkgname}" --strip-components=4 ./usr/share/buddycn
      tar -xf "$data_archive" -C "${pkgdir}/usr/share/icons/hicolor/256x256/apps" --strip-components=4 ./usr/share/pixmaps/buddycn.png
      
      local temp_desktop="${srcdir}/temp-desktop"
      mkdir -p "$temp_desktop"
      tar -xf "$data_archive" -C "$temp_desktop" --strip-components=4 ./usr/share/applications/buddycn.desktop
      tar -xf "$data_archive" -C "$temp_desktop" --strip-components=4 ./usr/share/applications/buddycn-url-handler.desktop
      
      # Extract license
      install -d "${pkgdir}/usr/share/licenses/${pkgname}"
      tar -xf "$data_archive" -C "${pkgdir}/usr/share/licenses/${pkgname}" --strip-components=4 ./usr/share/doc/codebuddy-cn/copyright
      mv "${pkgdir}/usr/share/licenses/${pkgname}/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  else
      # Copy from already extracted files in srcdir
      cp -a "${srcdir}/usr/share/buddycn/." "${pkgdir}/opt/${pkgname}/"
      cp "${srcdir}/usr/share/pixmaps/buddycn.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/"
      
      local temp_desktop="${srcdir}/usr/share/applications"
      
      # Copy license
      install -d "${pkgdir}/usr/share/licenses/${pkgname}"
      cp "${srcdir}/usr/share/doc/codebuddy-cn/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi

  # Rename icon
  mv "${pkgdir}/usr/share/icons/hicolor/256x256/apps/buddycn.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/codebuddycn.png"

  # Modify Exec and Icon paths for both desktop entries
  local desktop_src="${temp_desktop}/buddycn.desktop"
  if [ -f "$desktop_src" ]; then
      sed -e "s|/usr/share/buddycn/bin/buddycn|/usr/bin/${pkgname}|g" \
          -e "s|Icon=buddycn|Icon=codebuddycn|g" \
          "$desktop_src" > "${pkgdir}/usr/share/applications/${pkgname}.desktop"
      chmod 0644 "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  fi

  local url_desktop_src="${temp_desktop}/buddycn-url-handler.desktop"
  if [ -f "$url_desktop_src" ]; then
      sed -e "s|/usr/share/buddycn/bin/buddycn|/usr/bin/${pkgname}|g" \
          -e "s|Icon=buddycn|Icon=codebuddycn|g" \
          "$url_desktop_src" > "${pkgdir}/usr/share/applications/${pkgname}-url-handler.desktop"
      chmod 0644 "${pkgdir}/usr/share/applications/${pkgname}-url-handler.desktop"
  fi

  # Install launcher script
  cat > "${pkgdir}/usr/bin/${pkgname}" <<EOF
#!/bin/bash
exec /opt/${pkgname}/bin/buddycn "\$@"
EOF
  chmod 0755 "${pkgdir}/usr/bin/${pkgname}"

  # Install LICENSE.notice
  install -m 0644 "${srcdir}/LICENSE.notice" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.notice"
}
